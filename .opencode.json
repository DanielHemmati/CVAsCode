{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": "notify",
  "permission": {
    "bash": {
      "*": "ask",

      "terraform fmt*": "allow",
      "terraform validate*": "allow",

      "terraform apply*": "deny",
      "terraform destroy*": "deny",

      "aws * delete-*": "deny",

      "git status *": "allow",
      "git diff *": "allow",
      "git push*": "deny",
      "git reset --hard*": "deny",
      "git add*": "deny",

      "rm -rf*": "deny"
    }
  }
}
